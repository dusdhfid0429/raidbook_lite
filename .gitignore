# Python
__pycache__/
*.py[cod]
*.class
*.so
.Python
venv/
.venv/
env/

# Build
build/
dist/
redist/

# Logs
Log/
*.log

# Config (실제 설정은 제외, 템플릿만 포함)
Config/*.json
Config/*.txt
!Config/*.template.json
!Config/*.template.txt

# Data (실제 데이터는 제외, 템플릿만 포함)
# 하위 폴더(Backup 등)까지 재귀적으로 제외해 실수 커밋 방지
Data/*.xlsx
Data/*.json
Data/**/*.xlsx
Data/**/*.json
Data/Backup/
!Data/*_template.xlsx

# Temp
*.tmp
.DS_Store
Thumbs.db

# TTS 임시 음성 파일 (재생 후 자동 삭제, 잔존분 무시)
tts_*.mp3

# 데이터 수동 조작 백업 (실데이터 — 커밋 금지)
Data/*.bak.*
Data/*.purgebak_*

# 로컬 Claude 설정 (토큰 등 민감정보 포함 가능)
.claude/
